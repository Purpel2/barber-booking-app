datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  EMPLOYEE
  ADMIN
}

model TestService {
  id    String @id @default(uuid())
  title String
  price Int
}

model User {
  id          String   @id
  email       String   @unique
  firstName   String
  lastName    String
  fullName    String   // Do szybkiego renderowania w aplikacji
  phonePrefix String   // np. "+48"
  phoneBody   String   // np. "123456789"
  role        Role     @default(USER)
  createdAt   DateTime @default(now())
}