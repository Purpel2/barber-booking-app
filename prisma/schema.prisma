datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  EMPLOYEE
  ADMIN
}



model User {
  id          String   @id
  email       String   @unique
  firstName   String
  lastName    String
  fullName    String
  phonePrefix String
  phoneBody   String
  role        Role     @default(USER)
  createdAt   DateTime @default(now())
}
model Review {
  id         String   @id @default(uuid())
  content    String
  author     String
  rating     Float    @default(5.0)
  createdAt  DateTime @default(now())
}

model Barber {
  id        String   @id @default(dbgenerated("gen_random_uuid()"))
  name      String
  role      String
  bio       String
  imageUrl  String
  createdAt DateTime @default(dbgenerated("now()"))
  updatedAt DateTime @default(dbgenerated("now()")) @updatedAt
}

model Service {
  id          String   @id @default(cuid())
  name        String
  description String
  price       Int
  duration    Int
  imageUrl    String?
}